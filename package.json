{
  "name": "netdia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generate professional L1/L2/L3 network diagrams from one declarative model.",
  "license": "MIT",
  "bin": {
    "netdia": "./bin/netdia.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/",
    "build:3d": "esbuild src/render3d/scene.mjs --bundle --minify --format=esm --outfile=src/render3d/scene.bundle.js",
    "example": "node bin/netdia.mjs render examples/iac-lab.netdia.yaml -o out/iac-lab.html",
    "example:deps": "node bin/netdia.mjs render examples/ise-dependencies.netdia.yaml -o out/ise-dependencies.html"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "elkjs": "^0.12.0",
    "js-yaml": "^4.1.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
